{
  "name": "WilList",
  "short_name": "WilList",
  "description": "A student planner built on Brian Tracy's ABCDE method.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f6fa",
  "theme_color": "#4338ca",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
