<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Files WilList can read: shared to it from Mail, Files or Safari, they open in the Agent. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Schedule</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.image</string>
				<string>com.apple.ical.ics</string>
				<string>public.plain-text</string>
				<string>public.html</string>
				<string>public.comma-separated-values-text</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
				<string>org.openxmlformats.presentationml.presentation</string>
			</array>
		</dict>
	</array>
	<!-- willist://today and willist://add: the widgets open the app with these. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lull.willist</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>willist</string>
			</array>
		</dict>
	</array>
	<!-- A focus session's timer on the Lock Screen and in the Dynamic Island. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Press and hold the app icon. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.lull.willist.add</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New to-do</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAdd</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.lull.willist.search</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Search</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeSearch</string>
		</dict>
	</array>
	<!-- Always light. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- The WilList server the Agent talks to; empty until it exists, and the Agent shows Coming soon. -->
	<key>WLAgentServer</key>
	<string></string>
</dict>
</plist>
