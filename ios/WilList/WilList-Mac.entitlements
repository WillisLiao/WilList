<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app (Mac Catalyst) is sandboxed, as the Mac App Store requires. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The Agent talks to WilList's server; calendar links are read. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Files handed to the Agent, backups and restores, chosen by the student. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lull.willist</string>
	</array>
</dict>
</plist>
